{
  // config.json is for desktop app, tui.json for TUI ^^
  // https://opencode.ai/docs/config/
  "$schema": "https://opencode.ai/tui.json",
  "autoupdate": false,
  "formatter": true,
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.5
  },
  "permission": {
    // as basis for sandboxing, so the base paths that are possible to correct to are known
    "external_directory": {
      //"home/Projects/OpenCodeProjects/Free-Snap-Tap/Free-Snap-Tap": "allow",
      "home/AppData/Local/Temp/opencode": "allow",
      "home/.local/share/opencode/log": "allow",
      "home/AppData/Roaming/npm": "allow",
      "home/AppData/Roaming/npm/**": "allow",
      "home/AppData/Roaming/npm/node_modules/opencode-ai/**": "allow",
      "repo-root": "allow",
      "repo-root/**": "allow",
      "repo-root-v2": "allow",
      "repo-root-v2/**": "allow",
      "home/Repos/Free-Snap-Tap": "allow",
      "home/Repos/Free-Snap-Tap/**": "allow",
      "home/Repos/opencode": "allow",
      "home/Repos/opencode/**": "allow"
    }
  },
  "references": {
    "scratchpad": {
      "path": "home/AppData/Local/Temp/opencode",
      "description": "Local windows temporary directory for intermediate agent outputs"
    },
    "the estate (former name)": {
      "path": "repo-root",
      "description": "New Repo for our opencode agent - Deep Copy of Free-Snap-Tap"
    },
    "Free-Snap-Tap": {
      "path": "home/Repos/Free-Snap-Tap",
      "description": "clone of current Repo in new location"
    },
    "opencode": {
      "path": "home/Repos/opencode",
      "description": "forked opencode repo"
    },
    "copied_repos": {
      "path": "home/Repos/copied_repos",
      "description": "containing copies of repos that might be worth for research or as reference on a more permanent basis"
    }
  },
  // test to see if this is still triggering a rejection
  "watcher": {
    "ignore": ["home/AppData/Local/Temp/**", "home/AppData/Local/Temp/"]
  },
  // automatic revert of git changes on revert in session via TUI -> caused a lot of origin mismatches
  "snapshots": false,
  "compaction": {
    "auto": false,
    //"prune": false,
    //"reserved": 10000,
    "keep": {
      "system": true,
    // 2026-09-25_14-05: messages are ignored by V2 summerize -> only keepToken is respected
      "tokens": 40000,
      //"messages": 30
    },
    "buffer": 2000
  },
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "provider": {

    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8033/v1",
        "apiKey": "sk-strata-GL-hl1kXOGA9fKqQfEiaZicZz8BPaKJO"
      },
      "models": {
        "qwen3.8-flash-next-coder-iq1_m": {
          "name": "Qwen3.8-Flash-Next (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "input": 258048,
            "output": 20480
          }
        }
      }
    },

    "llama-swap": {
      "name": "llama-swap-v2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://local-inference-host/v1"
      },
      "models": {
        // -------------------
        // ik_llama.cpp backend with hadamard kv and optional trellis weights
        // -------------------
        "Qwen3.8-27B-Q3S-160K-MTP-Thireus": {
          "name": "Qwen3.8-27B-Q3S-MTP-Bee",
          "limit": {
            "context": 160000,
            "output": 160000
          }
        },
        // -------------------
        // beellama.cpp backend with kvarn kv cache
        // -------------------
        "Qwen3.8-27B-Q3S-140K-HQKV": {
          "name": "Qwen3.8-27B-Q3S-HQKV",
          "limit": {
            "context": 140000,
            "output": 140000
          }
        },
        "Qwen3.8-27B-Q3S-170K": {
          "name": "Qwen3.8-27B-Q3S",
          "limit": {
            "context": 170000,
            "output": 170000
          }
        },
        "Qwen3.8-27B-Q3S-245K-slow": {
          "name": "Qwen3.8-27B-Q3S-slow",
          "limit": {
            "context": 245000,
            "output": 245000
          }
        },
        "Qwen3.8-27B-Q3XS-262K": {
          "name": "Qwen3.8-27B-Q3XS",
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        // "Qwen3.8-27B-Compaction": {
        //   "name": "Qwen3.8-27B-Compaction",
        //   "limit": {
        //     "context": 135000,
        //     "output": 135000
        //   }
        // },
        "Qwen3.8-27B-Q3S-230K-slow-HQKV": {
          "name": "Qwen3.8-27B-Q3S-slowHQ",
          "limit": {
            "context": 230000,
            "output": 230000
          }
        },


        // -------------------
        // mainstream llama.cpp
        // -------------------
        "Gemma4-12B-Q4KM-UC-128K": {
          "name": "Gemma4-12B-Q4KM-UC",
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "Gemma4-12B-Q4KXL-MTP-128K": {
          "name": "Gemma4-12B-Q4KXL-MTP",
          "limit": {
            "context": 40000,
            "output": 40000
          }
        },
        // "CPU-Qwen3-0.6B": {
        //   "name": "CPU-Qwen3-0.6B",
        //   "limit": {
        //     "context": 32000,
        //     "output": 32000
        //   }
        // },
        // "CPU-Gemma4-E2B": {
        //   "name": "CPU-Gemma4-E2B",
        //   "limit": {
        //     "context": 32000,
        //     "output": 32000
        //   }
        // },
        // "CPU-Qwen3.5-4B": {
        //   "name": "CPU-Qwen3.5-4B",
        //    "limit": {
        //     "context": 16384,
        //     "output": 16384
        //   }
        // }-----------------
      }
    }
  },
  "subagent_depth": 2,
  "default_agent": "planner_FlashNext",
  "agent": {
    // when no compaction model is set, then the session own model will be used for compaction
