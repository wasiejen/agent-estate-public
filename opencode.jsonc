    "planner_FlashNext": {
      "description": "plans tasks and delegates to sub-agents: very high intelligence, speedrating 60, 262k context, high precision, highest general knowledge",
      "mode": "all",
      "model": "strata/qwen3.8-flash-next-coder-iq1_m",
      "prompt": "{file:./agent/prompts/agent_planner.md}\n{file:agent/memory/planner/destilled_mem.md}",
      // "prompt": "{file:./prompts/base.txt}\n{file:./prompts/rules.txt}\n{file:./prompts/examples.txt}"
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },
    "worker_FlashNext": {
      "description": "very high intelligence, speedrating 60, 262k context, high precision, highest general knowledge: best for very complex coding and code review work",
      "mode": "all",
      "model": "strata/qwen3.8-flash-next-coder-iq1_m",
      "prompt": "{file:./agent/prompts/agent_worker.md}",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "home/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agent/prompts/**": "deny",
          "agent/prompts/agent_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },
    "explorer_FlashNext": {
      "description": "very high intelligence, speedrating 60, 262k context, high precision, highest general knowledge: for research and exploration of needed information",
      "mode": "all",
      "model": "strata/qwen3.8-flash-next-coder-iq1_m",
      "prompt": "{file:./agent/prompts/agent_worker.md}\n{file:./agent/prompts/agent_explorer.md}",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "home/AppData/Local/Temp/opencode" : "allow",
